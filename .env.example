# Public site URL used for metadata and same-origin API protection
APP_URL=http://localhost:3000

# Anthropic chat
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Durable public-endpoint rate limiting (required in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=

# Bot verification and signed browser session (required in production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SECURITY_SESSION_SECRET=
ALLOW_PREVIEW_ORIGINS=false

# Optional Langfuse OpenTelemetry export
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com
LANGFUSE_PROJECT_ID=
SHOW_AI_TRACE=false
NEXT_PUBLIC_SHOW_AI_TRACE=false

# LiveKit voice mode
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
LIVEKIT_AGENT_NAME=
